# 인증: App Store Connect API 키 (환경변수 3개 필요)
#   ASC_KEY_ID    - 키 ID (예: ABC123XYZ)
#   ASC_ISSUER_ID - Issuer ID
#   ASC_KEY_PATH  - .p8 키 파일 경로
# App Store Connect > 사용자 및 액세스 > 통합 > API 키에서 발급 (역할: App Manager)

default_platform(:ios)

platform :ios do
  desc "Tuist 워크스페이스 생성"
  private_lane :generate do
    Dir.chdir("..") do
      sh("tuist", "install")
      sh("tuist", "generate", "--no-open")
    end
  end

  desc "테스트 실행"
  lane :test do
    generate
    run_tests(workspace: "FlyMate.xcworkspace", scheme: "FlyMate")
  end

  desc "TestFlight 업로드 (빌드 번호 자동 증가)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    generate
    build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    build_app(
      workspace: "FlyMate.xcworkspace",
      scheme: "FlyMate",
      output_directory: "build",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} -allowProvisioningUpdates"
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
